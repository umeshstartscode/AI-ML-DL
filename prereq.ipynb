        "\n",
        "\n",
        "# Python Collections & Built-ins\n",
        "\n",
        "You should know these before moving deep into DSA:\n",
        "\n",
        "## 1. List (vector equivalent)\n",
        "\n",
        "```python\n",
        "arr = [1, 2, 3]\n",
        "\n",
        "arr.append(4)\n",
        "arr.pop()\n",
        "arr.insert(1, 10)\n",
        "arr.remove(2)\n",
        "\n",
        "len(arr)\n",
        "arr.sort()\n",
        "arr.reverse()\n",
        "```\n",
        "\n",
        "---\n",
        "\n",
        "## 2. String\n",
        "\n",
        "```python\n",
        "s = \"hello\"\n",
        "\n",
        "s.lower()\n",
        "s.upper()\n",
        "s[::-1]\n",
        "s.split()\n",
        "```\n",
        "\n",
        "---\n",
        "\n",
        "## 3. Dictionary (unordered_map equivalent)\n",
        "\n",
        "```python\n",
        "freq = {}\n",
        "\n",
        "freq[1] = 5\n",
        "freq.get(1, 0)\n",
        "\n",
        "for k, v in freq.items():\n",
        "    print(k, v)\n",
        "```\n",
        "\n",
        "Used constantly for:\n",
        "\n",
        "* Hashing\n",
        "* Frequency counting\n",
        "* Two Sum\n",
        "* Sliding Window\n",
        "\n",
        "---\n",
        "\n",
        "## 4. Set (unordered_set equivalent)\n",
        "\n",
        "```python\n",
        "st = set()\n",
        "\n",
        "st.add(5)\n",
        "st.remove(5)\n",
        "\n",
        "if 5 in st:\n",
        "    print(\"Found\")\n",
        "```\n",
        "\n",
        "Used for:\n",
        "\n",
        "* Duplicate detection\n",
        "* Fast lookups\n",
        "\n",
        "---\n",
        "\n",
        "## 5. Stack\n",
        "\n",
        "Use a list:\n",
        "\n",
        "```python\n",
        "stack = []\n",
        "\n",
        "stack.append(10)\n",
        "stack.append(20)\n",
        "\n",
        "stack.pop()\n",
        "```\n",
        "\n",
        "Used in:\n",
        "\n",
        "* Next Greater Element\n",
        "* Monotonic Stack\n",
        "* DFS\n",
        "\n",
        "---\n",
        "\n",
        "## 6. Queue\n",
        "\n",
        "```python\n",
        "from collections import deque\n",
        "\n",
        "q = deque()\n",
        "\n",
        "q.append(1)\n",
        "q.append(2)\n",
        "\n",
        "q.popleft()\n",
        "```\n",
        "\n",
        "Used in:\n",
        "\n",
        "* BFS\n",
        "* Level Order Traversal\n",
        "\n",
        "---\n",
        "\n",
        "## 7. Heap (Priority Queue)\n",
        "\n",
        "```python\n",
        "import heapq\n",
        "\n",
        "heap = []\n",
        "\n",
        "heapq.heappush(heap, 5)\n",
        "heapq.heappush(heap, 2)\n",
        "\n",
        "heapq.heappop(heap)\n",
        "```\n",
        "\n",
        "Used in:\n",
        "\n",
        "* Top K problems\n",
        "* Dijkstra\n",
        "* Heaps\n",
        "\n",
        "---\n",
        "\n",
        "## 8. Counter\n",
        "\n",
        "```python\n",
        "from collections import Counter\n",
        "\n",
        "cnt = Counter([1,1,2,3])\n",
        "\n",
        "print(cnt[1])\n",
        "```\n",
        "\n",
        "Used for frequency counting.\n",
        "\n",
        "---\n",
        "\n",
        "## 9. DefaultDict\n",
        "\n",
        "```python\n",
        "from collections import defaultdict\n",
        "\n",
        "mp = defaultdict(int)\n",
        "\n",
        "mp[5] += 1\n",
        "```\n",
        "\n",
        "Avoids key errors.\n",
        "\n",
        "---\n",
        "\n",
        "## 10. Useful Built-ins\n",
        "\n",
        "```python\n",
        "max(arr)\n",
        "min(arr)\n",
        "sum(arr)\n",
        "\n",
        "sorted(arr)\n",
        "\n",
        "enumerate(arr)\n",
        "\n",
        "zip(a, b)\n",
        "```\n",
        "\n",
        "---\n",
        "\n",
      ]
    }
  ]
